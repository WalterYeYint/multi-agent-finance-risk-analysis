# .env.example
LANGCHAIN_API_KEY=YOUR_KEY_HERE
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="Multi-Agent Finance Bot"

#---- Uncomment only one model below (For now) ----#
# OPENAI_API_KEY=YOUR_KEY_HERE
OLLAMA_MODEL="llama3.2:3b"

POLYGON_API_KEY=YOUR_KEY_HERE

#---- Postgres + pgvector RAG store ----#
# Single store for filing metadata + embeddings (replaces ChromaDB).
# Needs a Postgres with the pgvector extension available, e.g.:
#   docker run -e POSTGRES_USER=finance -e POSTGRES_PASSWORD=finance \
#     -e POSTGRES_DB=finance_rag -p 5432:5432 pgvector/pgvector:pg16
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_rag

#---- SEC EDGAR auto-ingest (src/utils/edgar_ingest.py) ----#
# SEC requires a real contact string or it throttles requests.
SEC_USER_AGENT="Your Name your-email@example.com"
FILINGS_RAW_DIR=./data/filings_raw

#---- API auth + enqueue rate limiting (I1) ----#
# Gate ONLY the job-creation path (reads/polls stay open). Auth is opt-in:
# leave API_KEYS empty for local dev (enqueues allowed unauthenticated).
# Set a comma-separated list to require a key (Authorization: Bearer <k> or
# X-API-Key: <k>). The rate limit always applies (per key, else per IP).
# API_KEYS=key-for-frontend,key-for-scripts
ENQUEUE_RATE_LIMIT_PER_HOUR=30          # 0 disables the enqueue rate limit

#---- AWS Bedrock (N3) — only when MODEL_PROVIDER=bedrock ----#
# MODEL_PROVIDER=bedrock
# AWS_REGION=us-east-2
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_READ_TIMEOUT=300               # botocore default 60s is too short for large generations
# BEDROCK_MAX_RETRIES=3

#---- Speed knobs ----#
# DEBATE_MAX_TURNS=2                    # per-specialist debate turn cap (default 2)
# (The fundamental agent's RAG tool-call cap — max 3 batched query_10k_documents
#  calls — is baked into its prompt in src/agents.py. Output length is the
#  max_tokens default in config.py get_llm().)

#---- LLM cost metering + budgets ----#
# Every run's exact token spend is priced and stored in snapshots.cost_usd
# automatically (no config needed). Ceilings (0 = off):
# RUN_TOKEN_BUDGET=2000000              # hard per-run token ceiling — exceeding fails the job (opt-in, unset = off)
# DAILY_COST_BUDGET_USD=100             # worker pauses claiming jobs once the rolling-24h  (DEFAULT 100)
#                                       # snapshot spend crosses this; resumes automatically
# LLM_PRICE_INPUT_PER_MTOK=3.00         # $/Mtok override for models not in the built-in table
# LLM_PRICE_OUTPUT_PER_MTOK=15.00